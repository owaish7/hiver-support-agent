# Generator. Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Judge. Deliberately a DIFFERENT model family from the generator, because LLMs
# score their own family's output more generously (self-preference bias). If the
# same model wrote and graded the replies, the headline number would be inflated
# by an amount we cannot measure.
# Free tier: https://console.groq.com
GROQ_API_KEY=
